{
  "name": "a11y-ui",
  "version": "0.3.0",
  "description": "An accessible React component library built with TypeScript, Tailwind CSS and tested against WCAG 2.2 with axe-core.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "tailwind-preset.js",
    "tailwind-preset.d.ts",
    "themes.js",
    "themes.d.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.js"
    },
    "./themes": {
      "types": "./themes.d.ts",
      "default": "./themes.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:a11y": "vitest run --reporter verbose",
    "deploy-storybook": "npm run build-storybook && gh-pages -d storybook-static",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4 <4"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "react",
    "accessibility",
    "a11y",
    "wcag",
    "design-system",
    "typescript",
    "tailwind",
    "storybook"
  ]
}
